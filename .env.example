# Copy this file to .env for local runs. Do not commit .env.

# Required for real NAV feed sync. Keep this secret out of git.
NAV_FEED_TOKEN=

# Required for Discord posting. Keep the real webhook URL secret.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Optional tuning defaults
MIN_RELEVANCE_SCORE=18
MAX_FEED_PAGES=3
INITIAL_BACKFILL_PAGES=20
BACKFILL_DAYS=60
MAX_POSTS_PER_RUN=10
